{
  "productName": "clap-gui",
  "identifier": "com.vimclap.clap-gui",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "clap-gui",
        "width": 800,
        "height": 500,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "alwaysOnTop": true,
        "focus": true,
        "skipTaskbar": true
      }
    ]
  }
}
